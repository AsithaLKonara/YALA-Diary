// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(GUEST)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  GUEST
  STAFF
  ADMIN
}

// ─── Property / Rooms ─────────────────────────────────────────────────────

model Hotel {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  address            String?
  latitude           Float?
  longitude          Float?
  distanceFromYala   Float?
  category           String?  // e.g. Budget, Comfort, Premium
  facilities         String[]
  images             String[]
  active             Boolean  @default(true)
  
  // Provider integration
  providerConnectionId String?
  externalId         String?

  roomTypes          RoomType[]
  bookings           Booking[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model HotelProviderConnection {
  id                 String   @id @default(cuid())
  provider           String   // e.g. "SITEMINDER"
  externalPropertyId String
  status             String   // e.g. "ACTIVE", "DISCONNECTED"
  credentials        Json?    // e.g. { "username": "...", "password": "..." }
  lastSyncAt         DateTime?
  metadata           Json?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RoomType {
  id             String   @id @default(cuid())
  hotelId        String?
  hotel          Hotel?   @relation(fields: [hotelId], references: [id])
  externalId     String?
  name           String   // e.g. "Deluxe Tent", "Premium Suite"
  description    String?
  maxCapacity    Int
  pricePerNight  Float
  active         Boolean  @default(true)
  images         String[]
  
  ratePlans      RatePlan[]
  rooms          Room[]
  bookings       Booking[]
  createdAt      DateTime @default(now())
}

model RatePlan {
  id                 String   @id @default(cuid())
  hotelId            String
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  externalId         String?
  name               String
  mealPlan           String?
  cancellationPolicy String?
  active             Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Room {
  id         String     @id @default(cuid())
  number     String     @unique
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  roomTypeId String
  status     RoomStatus @default(AVAILABLE)
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

// ─── Bookings ─────────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  ref             String        @unique  // e.g. YD-2026-0001
  bookingAttemptId String?      @unique  // Idempotency key
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?

  // Guest info (for walk-in / non-registered guests)
  guestName       String
  guestEmail      String
  guestPhone      String
  guestCountry    String

  hotel           String        @default("Yala Diary")
  hotelRef        Hotel?        @relation(fields: [hotelId], references: [id])
  hotelId         String?
  
  externalReservationId String? // ID from Channel Manager

  roomType        RoomType      @relation(fields: [roomTypeId], references: [id])
  roomTypeId      String
  ratePlanId      String?

  room            Room?         @relation(fields: [roomId], references: [id])
  roomId          String?

  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  adults          Int           @default(1)
  children        Int           @default(0)

  status          BookingStatus @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)

  // Financials
  roomRevenue     Float
  addOnRevenue    Float         @default(0)
  totalRevenue    Float
  currency        String        @default("USD")

  addOns          BookingAddOn[]
  safariBookings  SafariBooking[]

  specialRequests String?
  promoCode       String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  events          BookingEvent[]
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_SUCCESS
  CREATING_RESERVATION
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  FAILED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String   // Old or new status
  action    String   // e.g. PAYMENT_SUCCESS, SITEMINDER_SYNC, SYNC_FAILED
  metadata  Json?
  createdAt DateTime @default(now())
}

model AddOnService {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Float
  category    AddOnCategory
  active      Boolean        @default(true)
  bookings    BookingAddOn[]
}

enum AddOnCategory {
  SAFARI
  FOOD
  SPA
  TRANSPORT
  OTHER
}

model BookingAddOn {
  id          String       @id @default(cuid())
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  addOn       AddOnService @relation(fields: [addOnId], references: [id])
  addOnId     String
  quantity    Int          @default(1)
  price       Float
}

// ─── Safari Slots ─────────────────────────────────────────────────────────

model SafariSlot {
  id        String          @id @default(cuid())
  date      DateTime
  slotType  SafariSlotType
  capacity  Int             @default(6)
  guide     String?
  bookings  SafariBooking[]
  createdAt DateTime        @default(now())
}

enum SafariSlotType {
  AM
  PM
}

model SafariBooking {
  id        String     @id @default(cuid())
  slot      SafariSlot @relation(fields: [slotId], references: [id])
  slotId    String
  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  guests    Int        @default(1)
}

// ─── Settings / Configuration ─────────────────────────────────────────────

model HotelProfile {
  id                 String   @id @default(cuid())
  hotelName          String   @default("Yala Diary")
  address            String
  phone              String
  email              String
  website            String
  checkInTime        String   @default("14:00")
  checkOutTime       String   @default("11:00")
  
  // Notification Preferences
  notifyNewBooking   Boolean  @default(true)
  notifyCancellation Boolean  @default(true)
  notifyCheckIn      Boolean  @default(true)
  notifyPayment      Boolean  @default(true)

  updatedAt          DateTime @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
